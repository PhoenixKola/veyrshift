{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "isolatedModules": true, "strict": true, "skipLibCheck": true,
    "noEmit": true, "allowImportingTsExtensions": false,
    "noFallthroughCasesInSwitch": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "types": ["vite/client"]
  },
  "include": ["src/app", "src/game", "src/main.tsx", "src/vite-env.d.ts"]
}
