{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ES2022", "moduleResolution": "Bundler", "strict": true,
    "skipLibCheck": true, "rootDir": "src", "outDir": "dist-preview/src",
    "noFallthroughCasesInSwitch": true, "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["src/game/**/*.ts", "src/preview/**/*.ts", "src/app/screenState.ts"]
}
